<!DOCTYPE html>
<html lang="ar" dir="rtl">


<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>لوحة تحكم الأدمن — اطلب من بيتك</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet"/>

<!-- Firebase SDKs -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js";
  import { getFirestore, collection, getDocs, doc, updateDoc, deleteDoc, query, orderBy, onSnapshot, addDoc } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js";
  import { getAuth, signInWithEmailAndPassword, signOut } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js";
  
  const firebaseConfig = {
    apiKey: "AIzaSyCu31Gb8MLmvxAZCurGKTSQs4DTePSWw_I",
    authDomain: "etlop--mn---betak.firebaseapp.com",
    projectId: "etlop--mn---betak",
    storageBucket: "etlop--mn---betak.firebasestorage.app",
    messagingSenderId: "415855489057",
    appId: "1:415855489057:web:d3526177d5a4353332f360"
  };
  
  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);
  const auth = getAuth(app);
  
  window.db = db;
  window.auth = auth;
  
  // جلب الطلبات في الوقت الفعلي
  window.getOrdersRealtime = (callback) => {
    const q = query(collection(db, "orders"), orderBy("createdAt", "desc"));
    return onSnapshot(q, (snapshot) => {
      const orders = [];
      snapshot.forEach(doc => orders.push({ id: doc.id, ...doc.data() }));
      callback(orders);
    });
  };
  
  // تحديث حالة الطلب
  window.updateOrderStatusFirebase = async (orderId, newStatus) => {
    const orderRef = doc(db, "orders", orderId);
    await updateDoc(orderRef, { status: newStatus, updatedAt: new Date().toISOString() });
  };
  
  // جلب السائقين
  window.getDriversFirebase = async () => {
    const snapshot = await getDocs(collection(db, "drivers"));
    const drivers = [];
    snapshot.forEach(doc => drivers.push({ id: doc.id, ...doc.data() }));
    return drivers;
  };
  
  // إضافة سائق
  window.addDriverFirebase = async (driverData) => {
    const docRef = await addDoc(collection(db, "drivers"), {
      ...driverData,
      createdAt: new Date().toISOString(),
      orders: 0,
      rating: 5.0
    });
    return docRef.id;
  };
  
  // حذف سائق
  window.deleteDriverFirebase = async (driverId) => {
    await deleteDoc(doc(db, "drivers", driverId));
  };
  
  // تسجيل دخول الأدمن
  window.adminLogin = async (email, password) => {
    try {
      const userCredential = await signInWithEmailAndPassword(auth, email, password);
      return { success: true, user: userCredential.user };
    } catch (error) {
      return { success: false, error: error.message };
    }
  };
  
  // تسجيل خروج
  window.adminLogout = async () => {
    await signOut(auth);
  };
  
  console.log("✅ Firebase ready - Admin Panel");
</script>

<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --or:#FF6B00;--or2:#FF8C3A;--or-pale:#FFF3E8;
  --nv:#0D2461;--nv2:#1A3580;
  --wh:#fff;--gl:#F0F3FB;--gm:#DDE3F2;
  --tx:#0D2461;--tm:#5A6A85;--tl:#9AAAC0;
  --green:#22C55E;--red:#EF4444;--yellow:#F59E0B;--blue:#3B82F6;
  --sidebar:240px;
}
body{font-family:'Cairo',sans-serif;direction:rtl;background:var(--gl);color:var(--tx);min-height:100vh;display:flex;flex-direction:column;}

/* ===== LOGIN ===== */
#login-screen{position:fixed;inset:0;background:var(--nv);display:flex;align-items:center;justify-content:center;z-index:1000;}
.login-box{background:#fff;border-radius:20px;padding:2.5rem;width:360px;box-shadow:0 20px 60px rgba(0,0,0,.25);text-align:center;}
.login-logo{font-size:52px;margin-bottom:.5rem;}
.login-title{font-size:22px;font-weight:900;color:var(--nv);margin-bottom:4px;}
.login-sub{font-size:13px;color:var(--tm);margin-bottom:2rem;}
.login-box input{width:100%;padding:12px 14px;border:1.5px solid var(--gm);border-radius:10px;font-family:'Cairo',sans-serif;font-size:14px;margin-bottom:12px;text-align:center;direction:ltr;}
.login-box input:focus{outline:none;border-color:var(--or);}
.login-btn{width:100%;background:var(--or);color:#fff;border:none;padding:13px;border-radius:12px;font-family:'Cairo',sans-serif;font-weight:700;font-size:15px;cursor:pointer;transition:.2s;}
.login-btn:hover{background:var(--or2);}
.login-err{color:var(--red);font-size:13px;margin-top:10px;display:none;}
.login-hint{font-size:11px;color:var(--tl);margin-top:12px;}

/* ===== APP ===== */
#app{display:none;flex:1;min-height:100vh;}
#app.on{display:flex;}

/* SIDEBAR */
.sidebar{width:var(--sidebar);background:var(--nv);min-height:100vh;display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow-y:auto;flex-shrink:0;}
.sb-brand{padding:1.25rem 1rem;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:10px;}
.sb-ico{width:38px;height:38px;background:var(--or);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;}
.sb-name{color:var(--or);font-size:15px;font-weight:900;line-height:1.1;}
.sb-tag{color:rgba(255,255,255,.4);font-size:9px;font-weight:600;}
.sb-nav{padding:.5rem 0;flex:1;}
.sb-sec{padding:8px 1rem 4px;font-size:10px;font-weight:700;color:rgba(255,255,255,.3);}
.sb-nav a{display:flex;align-items:center;gap:10px;padding:10px 1.25rem;color:rgba(255,255,255,.65);font-size:13px;font-weight:700;cursor:pointer;transition:.2s;border-right:3px solid transparent;}
.sb-nav a:hover{color:#fff;background:rgba(255,255,255,.06);}
.sb-nav a.act{color:#fff;background:rgba(255,107,0,.18);border-right-color:var(--or);}
.sb-nav a .ico{font-size:17px;width:22px;text-align:center;}
.sb-badge{margin-right:auto;background:var(--or);color:#fff;font-size:11px;font-weight:900;padding:2px 8px;border-radius:10px;min-width:22px;text-align:center;}
.sb-footer{padding:1rem;border-top:1px solid rgba(255,255,255,.08);}
.sb-user{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.sb-avatar{width:34px;height:34px;background:rgba(255,107,0,.25);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;}
.sb-uname{color:#fff;font-size:13px;font-weight:700;}
.sb-role{color:rgba(255,255,255,.4);font-size:11px;}
.logout-btn{background:transparent;border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.6);padding:6px 10px;border-radius:8px;font-family:'Cairo',sans-serif;font-size:12px;cursor:pointer;width:100%;transition:.2s;}
.logout-btn:hover{border-color:var(--red);color:var(--red);}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;}
.topbar{background:#fff;height:60px;display:flex;align-items:center;justify-content:space-between;padding:0 1.5rem;border-bottom:1px solid var(--gm);position:sticky;top:0;z-index:50;box-shadow:0 1px 8px rgba(13,36,97,.06);}
.topbar-left{display:flex;align-items:center;gap:10px;}
.topbar-title{font-size:17px;font-weight:900;}
.topbar-right{display:flex;align-items:center;gap:10px;}
.refresh-btn{background:var(--nv);color:#fff;border:none;padding:8px 16px;border-radius:9px;font-family:'Cairo',sans-serif;font-weight:700;font-size:12px;cursor:pointer;transition:.2s;}
.refresh-btn:hover{background:var(--nv2);}
.content{flex:1;padding:1.5rem;overflow-y:auto;}
.page{display:none;}.page.on{display:block;}
.page-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;}
.page-hd h2{font-size:18px;font-weight:900;}

/* ===== KPI ===== */
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:1.5rem;}
.kpi{background:#fff;border-radius:16px;padding:1.25rem;border:1.5px solid var(--gm);display:flex;align-items:center;gap:14px;transition:.2s;}
.kpi:hover{border-color:var(--or);transform:translateY(-2px);}
.kpi-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.kpi-icon.or{background:rgba(255,107,0,.12);}
.kpi-icon.gr{background:rgba(34,197,94,.12);}
.kpi-icon.bl{background:rgba(59,130,246,.12);}
.kpi-icon.yl{background:rgba(245,158,11,.12);}
.kpi-num{font-size:26px;font-weight:900;}
.kpi-lbl{font-size:12px;color:var(--tm);margin-top:2px;}
.kpi-sub{font-size:11px;color:var(--green);font-weight:700;margin-top:3px;}

/* ===== CARDS ===== */
.card{background:#fff;border-radius:16px;padding:1.25rem;border:1.5px solid var(--gm);}
.card-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;padding-bottom:.75rem;border-bottom:1px solid var(--gm);}
.card-hd h3{font-size:14px;font-weight:800;}
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:1.5rem;}

.mini-order{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--gm);}
.mini-order:last-child{border-bottom:none;}
.mo-ico{width:34px;height:34px;background:var(--gl);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.mo-info{flex:1;min-width:0;}
.mo-id{font-size:13px;font-weight:700;}
.mo-sub{font-size:11px;color:var(--tm);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.badge{display:inline-block;padding:3px 9px;border-radius:8px;font-size:11px;font-weight:700;white-space:nowrap;}
.b-new{background:#FEF3C7;color:#92400E;}
.b-go{background:#DCFCE7;color:#166534;}
.b-done{background:#EFF6FF;color:#1D4ED8;}
.b-cancel{background:#FEE2E2;color:#991B1B;}

.dr-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--gm);}
.dr-row:last-child{border-bottom:none;}
.dr-av{width:34px;height:34px;background:var(--or-pale);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;}
.dr-info{flex:1;}
.dr-name{font-size:13px;font-weight:700;}
.dr-sub{font-size:11px;color:var(--tm);margin-top:1px;}
.status-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.dot-on{background:var(--green);}
.dot-off{background:var(--gm);}

/* ===== TABLE ===== */
.filters{display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap;align-items:center;}
.fbtn{background:#fff;border:1.5px solid var(--gm);color:var(--tm);padding:7px 14px;border-radius:10px;font-family:'Cairo',sans-serif;font-weight:700;font-size:13px;cursor:pointer;transition:.2s;}
.fbtn:hover,.fbtn.act{background:var(--or);border-color:var(--or);color:#fff;}
.search-wrap{flex:1;max-width:260px;position:relative;}
.search-wrap input{width:100%;padding:8px 14px;border:1.5px solid var(--gm);border-radius:10px;font-family:'Cairo',sans-serif;font-size:13px;background:#fff;direction:rtl;text-align:right;}
.search-wrap input:focus{outline:none;border-color:var(--or);}
.tbl-wrap{background:#fff;border-radius:16px;border:1.5px solid var(--gm);overflow:auto;}
table{width:100%;border-collapse:collapse;min-width:700px;}
thead tr{background:var(--gl);}
th{padding:11px 14px;font-size:12px;font-weight:700;color:var(--tm);text-align:right;white-space:nowrap;}
td{padding:11px 14px;font-size:13px;border-top:1px solid var(--gm);vertical-align:middle;}
tr:hover td{background:rgba(13,36,97,.02);}
.action-btns{display:flex;gap:6px;flex-wrap:nowrap;}
.abtn{border:none;padding:6px 11px;border-radius:8px;font-family:'Cairo',sans-serif;font-size:12px;font-weight:700;cursor:pointer;transition:.2s;white-space:nowrap;}
.abtn.grn{background:rgba(34,197,94,.12);color:var(--green);}
.abtn.grn:hover{background:var(--green);color:#fff;}
.abtn.red{background:rgba(239,68,68,.1);color:var(--red);}
.abtn.red:hover{background:var(--red);color:#fff;}
.abtn.bl{background:rgba(59,130,246,.1);color:var(--blue);}
.abtn.bl:hover{background:var(--blue);color:#fff;}
.abtn.or{background:var(--or-pale);color:var(--or);}
.abtn.or:hover{background:var(--or);color:#fff;}
.empty-state{text-align:center;padding:3rem;color:var(--tm);font-size:14px;}
.empty-state div{font-size:36px;margin-bottom:10px;}

/* ===== DRIVERS PAGE ===== */
.drivers-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px;margin-top:1rem;}
.dcard{background:#fff;border:1.5px solid var(--gm);border-radius:16px;padding:1.25rem;transition:.2s;}
.dcard:hover{border-color:var(--or);}
.dcard-top{display:flex;align-items:center;gap:12px;margin-bottom:1rem;padding-bottom:1rem;border-bottom:1px solid var(--gm);}
.dav{width:44px;height:44px;background:var(--or-pale);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;}
.d-name{font-size:14px;font-weight:800;}
.d-sub{font-size:12px;color:var(--tm);margin-top:2px;}
.d-stat{display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px;}
.d-stat span:first-child{color:var(--tm);}
.d-stat span:last-child{font-weight:700;}
.pill{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:10px;font-size:11px;font-weight:700;}
.pill-on{background:#DCFCE7;color:#166534;}
.pill-off{background:var(--gl);color:var(--tm);}
.dcard-btns{display:flex;gap:8px;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--gm);}
.driver-form-card{background:#fff;border:1.5px solid var(--gm);border-radius:16px;padding:1.75rem;max-width:600px;margin:0 auto;}
.fg{margin-bottom:.85rem;}
.fl{display:block;font-size:12px;font-weight:700;color:var(--tm);margin-bottom:5px;}
.fi{width:100%;padding:10px 13px;border:1.5px solid var(--gm);border-radius:9px;font-family:'Cairo',sans-serif;font-size:14px;background:var(--gl);}
.fi:focus{outline:none;border-color:var(--or);background:#fff;}
.fr2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}

.toast{position:fixed;top:18px;left:50%;transform:translateX(-50%);background:var(--nv);color:#fff;padding:11px 24px;border-radius:12px;font-size:14px;font-weight:700;display:none;z-index:9999;box-shadow:0 8px 24px rgba(0,0,0,.2);white-space:nowrap;}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="login-screen">
  <div class="login-box">
    <div class="login-logo">🛵</div>
    <div class="login-title">اطلب من بيتك</div>
    <div class="login-sub">لوحة تحكم الأدمن</div>
    <input type="email" id="l-email" placeholder="البريد الإلكتروني"/>
    <input type="password" id="l-pass" placeholder="كلمة السر"/>
    <button class="login-btn" onclick="doLogin()">دخول ➜</button>
    <div id="l-err" class="login-err"></div>
    <div class="login-hint">admin@admin.com | EMB@2025!port</div>
  </div>
</div>

<!-- APP -->
<div id="app">
  <aside class="sidebar">
    <div class="sb-brand"><div class="sb-ico">🛵</div><div><div class="sb-name">اطلب من بيتك</div><div class="sb-tag">Admin Panel</div></div></div>
    <nav class="sb-nav">
      <div class="sb-sec">القائمة الرئيسية</div>
      <a class="act" onclick="nav('dash')"><span class="ico">📊</span>الرئيسية</a>
      <a onclick="nav('orders')"><span class="ico">📋</span>الطلبات<span class="sb-badge" id="new-count">0</span></a>
      <div class="sb-sec">الإدارة</div>
      <a onclick="nav('drivers')"><span class="ico">🛵</span>السائقين</a>
      <a onclick="nav('add-driver')"><span class="ico">➕</span>إضافة سائق</a>
    </nav>
    <div class="sb-footer">
      <div class="sb-user"><div class="sb-avatar">👤</div><div><div class="sb-uname" id="sb-uname-txt">أدمن</div><div class="sb-role">مدير النظام</div></div></div>
      <button class="logout-btn" onclick="doLogout()">🚪 تسجيل خروج</button>
    </div>
  </aside>

  <div class="main">
    <div class="topbar">
      <div class="topbar-left"><div class="topbar-title" id="page-title">الرئيسية</div></div>
      <div class="topbar-right"><button class="refresh-btn" onclick="refresh()">🔄 تحديث</button></div>
    </div>
    <div class="content">
      
      <!-- DASHBOARD -->
      <div id="page-dash" class="page on">
        <div class="kpi-grid">
          <div class="kpi"><div class="kpi-icon or">📋</div><div><div class="kpi-num" id="k-total">0</div><div class="kpi-lbl">إجمالي الطلبات</div></div></div>
          <div class="kpi"><div class="kpi-icon gr">✅</div><div><div class="kpi-num" id="k-done">0</div><div class="kpi-lbl">تم التوصيل</div></div></div>
          <div class="kpi"><div class="kpi-icon bl">🛵</div><div><div class="kpi-num" id="k-active">0</div><div class="kpi-lbl">جاري التوصيل</div></div></div>
          <div class="kpi"><div class="kpi-icon yl">💰</div><div><div class="kpi-num" id="k-rev">0 جم</div><div class="kpi-lbl">إيرادات اليوم</div></div></div>
        </div>
        <div class="dash-grid">
          <div class="card"><div class="card-hd"><h3>📋 آخر الطلبات</h3><a style="font-size:12px;color:var(--or);cursor:pointer;font-weight:700" onclick="nav('orders')">عرض الكل ←</a></div><div id="dash-orders"></div></div>
          <div class="card"><div class="card-hd"><h3>🛵 آخر السائقين</h3><a style="font-size:12px;color:var(--or);cursor:pointer;font-weight:700" onclick="nav('drivers')">إدارة ←</a></div><div id="dash-drivers"></div></div>
        </div>
      </div>

      <!-- ORDERS -->
      <div id="page-orders" class="page">
        <div class="page-hd"><h2>إدارة الطلبات</h2></div>
        <div class="filters">
          <button class="fbtn act" onclick="filterOrders('all',this)">الكل</button>
          <button class="fbtn" onclick="filterOrders('جديد',this)">🟡 جديد</button>
          <button class="fbtn" onclick="filterOrders('جاري التوصيل',this)">🟢 جاري</button>
          <button class="fbtn" onclick="filterOrders('تم التوصيل',this)">✅ مكتمل</button>
          <div class="search-wrap"><input type="text" placeholder="🔍 ابحث..." oninput="searchOrders(this.value)"/></div>
        </div>
        <div class="tbl-wrap">
          <table><thead><tr><th>#</th><th>رقم الطلب</th><th>النوع</th><th>المحل</th><th>العنوان</th><th>التليفون</th><th>الوقت</th><th>الحالة</th><th>إجراءات</th></tr></thead><tbody id="orders-tbody"></tbody></table>
        </div>
      </div>

      <!-- DRIVERS LIST -->
      <div id="page-drivers" class="page">
        <div class="page-hd"><h2>السائقين المسجلين</h2><button class="abtn grn" onclick="nav('add-driver')">➕ إضافة سائق</button></div>
        <div class="drivers-grid" id="drivers-grid"></div>
      </div>

      <!-- ADD DRIVER -->
      <div id="page-add-driver" class="page">
        <div class="page-hd"><h2>➕ إضافة سائق جديد</h2></div>
        <div class="driver-form-card">
          <div class="fr2">
            <div class="fg"><label class="fl">الاسم الأول *</label><input class="fi" id="d-fname" type="text" placeholder="محمود"/></div>
            <div class="fg"><label class="fl">الاسم الأخير *</label><input class="fi" id="d-lname" type="text" placeholder="أحمد"/></div>
          </div>
          <div class="fg"><label class="fl">رقم التليفون *</label><input class="fi" id="d-phone" type="tel" placeholder="01XXXXXXXXX"/></div>
          <div class="fg"><label class="fl">المنطقة *</label><input class="fi" id="d-area" type="text" placeholder="الحي السادس"/></div>
          <div class="fg"><label class="fl">نوع المركبة</label><select class="fi" id="d-vtype"><option>دراجة نارية</option><option>توك توك</option><option>سيارة</option></select></div>
          <div class="fr2">
            <div class="fg"><label class="fl">اسم المستخدم *</label><input class="fi" id="d-uname" type="text" placeholder="driver_name"/></div>
            <div class="fg"><label class="fl">كلمة السر *</label><input class="fi" id="d-pass" type="password" placeholder="******"/></div>
          </div>
          <div style="display:flex;gap:12px;margin-top:1.5rem">
            <button class="abtn grn" style="flex:1;padding:12px" onclick="saveDriver()">💾 حفظ السائق</button>
            <button class="abtn gray" style="flex:1;padding:12px" onclick="nav('drivers')">إلغاء</button>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
let currentOrders = [];
let currentDrivers = [];
let currentFilter = 'all';
let currentSearch = '';
let unsubscribeOrders = null;

// ========= LOGIN =========
async function doLogin() {
  const email = document.getElementById('l-email').value.trim();
  const password = document.getElementById('l-pass').value.trim();
  
  if (!email || !password) {
    showToast('⚠️ ادخل البريد الإلكتروني وكلمة السر', true);
    return;
  }
  
  const result = await window.adminLogin(email, password);
  if (result.success) {
    document.getElementById('login-screen').style.display = 'none';
    document.getElementById('app').classList.add('on');
    document.getElementById('sb-uname-txt').textContent = email.split('@')[0];
    startRealtime();
  } else {
    document.getElementById('l-err').textContent = '❌ ' + result.error;
    document.getElementById('l-err').style.display = 'block';
  }
}

function doLogout() {
  window.adminLogout();
  if (unsubscribeOrders) unsubscribeOrders();
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('app').classList.remove('on');
}

// ========= REALTIME =========
function startRealtime() {
  if (unsubscribeOrders) unsubscribeOrders();
  unsubscribeOrders = window.getOrdersRealtime((orders) => {
    currentOrders = orders;
    renderCurrentPage();
    loadDrivers();
  });
}

async function loadDrivers() {
  currentDrivers = await window.getDriversFirebase();
  if (document.getElementById('page-drivers').classList.contains('on')) renderDrivers();
  if (document.getElementById('page-dash').classList.contains('on')) renderDash();
}

function renderCurrentPage() {
  if (document.getElementById('page-dash').classList.contains('on')) renderDash();
  if (document.getElementById('page-orders').classList.contains('on')) renderOrders();
}

// ========= DASHBOARD =========
function renderDash() {
  const total = currentOrders.length;
  const done = currentOrders.filter(o => o.status === 'تم التوصيل').length;
  const active = currentOrders.filter(o => o.status === 'جاري التوصيل').length;
  const newCount = currentOrders.filter(o => o.status === 'جديد').length;
  
  document.getElementById('k-total').textContent = total;
  document.getElementById('k-done').textContent = done;
  document.getElementById('k-active').textContent = active;
  document.getElementById('k-rev').textContent = (done * 25) + ' جم';
  document.getElementById('new-count').textContent = newCount;
  
  const dashOrders = document.getElementById('dash-orders');
  if (currentOrders.length === 0) {
    dashOrders.innerHTML = '<div class="empty-state"><div>📭</div>لا توجد طلبات</div>';
  } else {
    dashOrders.innerHTML = currentOrders.slice(0, 5).map(o => `
      <div class="mini-order" onclick="viewOrder('${o.id}')" style="cursor:pointer">
        <div class="mo-ico">📦</div>
        <div class="mo-info"><div class="mo-id">${o.id}</div><div class="mo-sub">${o.place} | ${o.addr}</div></div>
        <span class="badge ${o.status === 'جديد' ? 'b-new' : o.status === 'جاري التوصيل' ? 'b-go' : 'b-done'}">${o.status}</span>
      </div>
    `).join('');
  }
  
  const dashDrivers = document.getElementById('dash-drivers');
  if (currentDrivers.length === 0) {
    dashDrivers.innerHTML = '<div class="empty-state"><div>🛵</div>لا يوجد سائقين</div>';
  } else {
    dashDrivers.innerHTML = currentDrivers.slice(0, 5).map(d => `
      <div class="dr-row"><div class="dr-av">🛵</div><div class="dr-info"><div class="dr-name">${d.fname} ${d.lname}</div><div class="dr-sub">${d.area}</div></div><div class="status-dot dot-on"></div></div>
    `).join('');
  }
}

// ========= ORDERS =========
function renderOrders() {
  let filtered = [...currentOrders];
  if (currentFilter !== 'all') filtered = filtered.filter(o => o.status === currentFilter);
  if (currentSearch) filtered = filtered.filter(o => o.id?.toLowerCase().includes(currentSearch) || o.phone?.includes(currentSearch));
  
  const tbody = document.getElementById('orders-tbody');
  if (filtered.length === 0) {
    tbody.innerHTML = '<tr><td colspan="9"><div class="empty-state"><div>📭</div>لا توجد طلبات</div></td></tr>';
    return;
  }
  
  tbody.innerHTML = filtered.map((o, i) => `
    <tr><td>${i+1}</td>
      <td><strong style="color:var(--or)">${o.id}</strong></td>
      <td>${o.type}</td><td>${o.place}</td><td>${o.addr}</td>
      <td dir="ltr">${o.phone}</td>
      <td>${o.time || o.createdAt?.substring(11,16) || '—'}</td>
      <td><span class="badge ${o.status === 'جديد' ? 'b-new' : o.status === 'جاري التوصيل' ? 'b-go' : 'b-done'}">${o.status}</span></td>
      <td><div class="action-btns">
        <button class="abtn bl" onclick="viewOrder('${o.id}')">عرض</button>
        ${o.status === 'جديد' ? `<button class="abtn grn" onclick="updateOrder('${o.id}','جاري التوصيل')">قبول</button><button class="abtn red" onclick="updateOrder('${o.id}','ملغي')">رفض</button>` : ''}
        ${o.status === 'جاري التوصيل' ? `<button class="abtn or" onclick="updateOrder('${o.id}','تم التوصيل')">تم</button>` : ''}
      </div></td>
    </tr>
  `).join('');
}

function filterOrders(filter, btn) {
  currentFilter = filter;
  document.querySelectorAll('.fbtn').forEach(b => b.classList.remove('act'));
  btn.classList.add('act');
  renderOrders();
}

function searchOrders(value) {
  currentSearch = value.trim().toLowerCase();
  renderOrders();
}

async function updateOrder(id, newStatus) {
  await window.updateOrderStatusFirebase(id, newStatus);
  showToast('✅ تم تحديث الطلب');
}

function viewOrder(id) {
  const order = currentOrders.find(o => o.id === id);
  if (!order) return;
  alert(`📋 الطلب: ${order.id}\n🍕 النوع: ${order.type}\n🏪 المحل: ${order.place}\n📍 العنوان: ${order.addr}\n📞 التليفون: ${order.phone}\n🕐 الوقت: ${order.time}\n📌 الحالة: ${order.status}`);
}

// ========= DRIVERS =========
async function renderDrivers() {
  const grid = document.getElementById('drivers-grid');
  if (currentDrivers.length === 0) {
    grid.innerHTML = '<div class="empty-state" style="grid-column:span 4"><div>🛵</div>لا يوجد سائقين<br><button class="abtn grn" style="margin-top:10px" onclick="nav(\'add-driver\')">➕ أضف سائق</button></div>';
    return;
  }
  
  grid.innerHTML = currentDrivers.map(d => `
    <div class="dcard">
      <div class="dcard-top">
        <div class="dav">🛵</div>
        <div><div class="d-name">${d.fname} ${d.lname}</div><div class="d-sub">📞 ${d.phone}</div></div>
        <span class="pill pill-on">مفعل</span>
      </div>
      <div class="d-stat"><span>المنطقة</span><span>${d.area}</span></div>
      <div class="d-stat"><span>المركبة</span><span>${d.vtype}</span></div>
      <div class="d-stat"><span>الطلبات</span><span>${d.orders || 0}</span></div>
      <div class="dcard-btns">
        <button class="abtn red" onclick="deleteDriver('${d.id}')">🗑️ حذف</button>
      </div>
    </div>
  `).join('');
}

async function saveDriver() {
  const fname = document.getElementById('d-fname').value.trim();
  const lname = document.getElementById('d-lname').value.trim();
  const phone = document.getElementById('d-phone').value.trim();
  const area = document.getElementById('d-area').value.trim();
  const uname = document.getElementById('d-uname').value.trim();
  const pass = document.getElementById('d-pass').value.trim();
  
  if (!fname || !lname || !phone || !area || !uname || !pass) {
    showToast('⚠️ من فضلك اكمل جميع الحقول', true);
    return;
  }
  
  const newDriver = { fname, lname, phone, area, vtype: document.getElementById('d-vtype').value, uname, pass };
  await window.addDriverFirebase(newDriver);
  showToast('✅ تم إضافة السائق');
  await loadDrivers();
  nav('drivers');
}

async function deleteDriver(id) {
  if (confirm('هل أنت متأكد من حذف هذا السائق؟')) {
    await window.deleteDriverFirebase(id);
    showToast('🗑️ تم حذف السائق');
    await loadDrivers();
    renderDrivers();
  }
}

// ========= NAVIGATION =========
function nav(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('on'));
  document.getElementById(`page-${id}`).classList.add('on');
  document.querySelectorAll('.sb-nav a').forEach(a => a.classList.remove('act'));
  const link = document.querySelector(`.sb-nav a[onclick="nav('${id}')"]`);
  if (link) link.classList.add('act');
  
  const titles = { dash: 'الرئيسية', orders: 'الطلبات', drivers: 'السائقين', 'add-driver': 'إضافة سائق' };
  document.getElementById('page-title').textContent = titles[id] || id;
  
  if (id === 'drivers') renderDrivers();
  if (id === 'dash') renderDash();
}

function refresh() {
  loadDrivers();
  showToast('🔄 تم التحديث');
}

function showToast(msg, isError = false) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.background = isError ? '#EF4444' : '#0D2461';
  t.style.display = 'block';
  setTimeout(() => t.style.display = 'none', 3000);
}

// ========= INIT =========
loadDrivers();
</script>
</body>
</html>
